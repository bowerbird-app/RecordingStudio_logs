<% content_for :title, "Logs" %>
<% dummy_page_nav(back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "What's counting",
    subtitle: "Site views and downloads this dummy rolls up.",
    variant: :h1
  ) %>

  <%= render FlatPack::Table::Component.new(data: @logs, class: "text-sm") do |table| %>
    <% table.column(title: "Log") { |log| log.model_name } %>
    <% table.column(title: "From") { |log| log.owner } %>
    <% table.column(title: "Keeps") { |log| log.retention_label } %>
    <% table.column(title: "Summaries") { |log| RecordingStudioLogs.registry.aggregations_for(log).size } %>
  <% end %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Daily rollups",
    subtitle: "Each one reads the same raw rows without copying them."
  ) %>

  <%= render FlatPack::Table::Component.new(data: @aggregations, class: "text-sm") do |table| %>
    <% table.column(title: "Summary") { |definition| definition.name } %>
    <% table.column(title: "From") { |definition| definition.owner } %>
    <% table.column(title: "Source") { |definition| definition.source.name } %>
  <% end %>
</div>
